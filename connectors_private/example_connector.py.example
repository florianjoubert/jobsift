# Template for a private jobsift connector
#
# Drop a *.py file in this directory to add an unlisted job source.
# The registry (`app/connectors/registry.py`) discovers and instantiates it
# automatically at startup - no changes to the main codebase required.
#
# This directory is fully gitignored (except README.md and this file).
# Your connector stays local and will never be published.
#
# ── Required interface ────────────────────────────────────────────────────
#
#   - The class must be named `Connector`.
#   - It must expose a `name: str` attribute (unique source identifier).
#   - It must implement `fetch(self, criteria: SearchCriteria) -> list[Job]`.
#   - It must use `source=JobSource.private` for all returned listings,
#     so the source is not revealed in public logs.
#   - The `fetch` method must NEVER raise: log errors and return `[]` on failure.
#
# ── Quick start ───────────────────────────────────────────────────────────
#
#  1. Copy this file:
#
#       cp connectors_private/example_connector.py.example connectors_private/my_source.py
#
#  2. Edit `my_source.py` to implement the fetch logic.
#
#  3. Trigger a run:
#
#       uv run python -m app.cli
#
#     You should see in the logs:
#       Connecteur privé chargé : my_source
#       Connecteurs actifs : [..., 'my_source']
#
# ─────────────────────────────────────────────────────────────────────────────

import logging

