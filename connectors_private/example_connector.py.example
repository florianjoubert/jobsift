        """Fetch listings from the private source and normalise them into Job objects.

        Args:
            criteria: search keywords and time window.

        Returns:
            List of normalised listings. Returns [] on error.
        """
        # TODO: implement the fetch logic
        logger.info(f"{self.name} : stub actif, aucune offre retournée.")
        return []
